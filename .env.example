# NVIDIA NIM API Configuration
# Get your API key from https://build.nvidia.com/
NIM_API_KEY=your_nvidia_nim_api_key_here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_DEFAULT_MODEL=mistralai/mixtral-8x7b-instruct-v0.1

# Google ADK (optional - for advanced AI orchestration)
# GOOGLE_ADK_API_KEY=your_google_api_key_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/factverse

# Redis
REDIS_URL=redis://localhost:6379

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (for admin dashboard)
ADMIN_EMAIL=admin@factverse.ai
ADMIN_PASSWORD=changeme123

# Feature Flags
ENABLE_AI_GENERATION=true
ENABLE_AUTO_PUBLISH=false
MIN_CONFIDENCE_THRESHOLD=0.7

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Logging
LOG_LEVEL=info
